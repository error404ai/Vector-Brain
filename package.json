{
  "name": "vector-brain",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Vector-Brain API Service",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc -b tsconfig.json --force && tsc-alias",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "predev": "npm run build",
    "dev:types": "tsc -b tsconfig.json --watch --preserveWatchOutput",
    "dev:aliases": "tsc-alias -w",
    "dev:serve": "cross-env NODE_ENV=development nodemon",
    "dev:backend": "concurrently -k -n BUILD,ALIAS,SERVER -c cyan,magenta,green \"npm run dev:types\" \"npm run dev:aliases\" \"npm run dev:serve\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm install && npm run install:frontend",
    "migrate:generate": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:generate ./src/migrations/auto-generated --dataSource src/loaders/database.ts",
    "migrate:create": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:create ./src/migrations/migration",
    "migrate:run": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:run --dataSource src/loaders/database.ts",
    "migrate:revert": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:revert --dataSource src/loaders/database.ts",
    "db:drop": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js schema:drop --dataSource src/loaders/database.ts",
    "db:sync": "cross-env NODE_ENV=development node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js schema:sync --dataSource src/loaders/database.ts",
    "db:seed": "cross-env NODE_ENV=development node --import ./scripts/ts-node-loader.mjs src/seeders/index.ts",
    "db:fresh": "cross-env NODE_ENV=development npm run db:drop && cross-env NODE_ENV=development npm run db:sync && cross-env NODE_ENV=development npm run db:seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --maxWorkers=1"
  },
  "keywords": [
    "express",
    "typescript",
    "typeorm",
    "api",
    "rest"
  ],
  "author": "Vector Software",
  "license": "MIT",
  "dependencies": {
    "@types/winston": "^2.4.4",
    "axios": "^1.13.2",
    "body-parser": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^8.6.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.21",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^11.0.5",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  }
}
