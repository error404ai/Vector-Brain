# -- Stage 1: Build ---------------------------------------------------------
FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

ENV NODE_OPTIONS=--max-old-space-size=2048

COPY package.json pnpm-lock.yaml ./
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./frontend/

RUN pnpm install --frozen-lockfile
RUN cd frontend && pnpm install --frozen-lockfile

COPY . .

RUN pnpm run build
RUN cd frontend && pnpm run build

# -- Stage 2: Production ----------------------------------------------------
FROM node:24-alpine AS production

RUN corepack enable && corepack prepare pnpm@latest --activate

# ffmpeg renders shared runs into an MP4, and the DejaVu font is what its
# drawtext filter uses for the social preview card. Both are system packages,
# so the pnpm lockfile stays untouched.
# font-dejavu is the package's real name; ttf-dejavu is an old alias that newer
# Alpine indexes no longer carry. The retry is for the mirror itself: a failed
# index fetch (seen as "TLS: unspecified error") leaves apk unable to resolve
# anything, and that has already failed one deploy on a build that was fine.
RUN apk add --no-cache ffmpeg font-dejavu \
 || (sleep 5 && apk update && apk add --no-cache ffmpeg font-dejavu) \
 || (sleep 15 && apk update && apk add --no-cache ffmpeg font-dejavu)

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY package.json pnpm-lock.yaml tsconfig.json ./
COPY scripts ./scripts

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["sh", "-c", "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:run --dataSource src/loaders/database.ts && exec node dist/app.js"]
