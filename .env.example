# Application
APP_URL=http://localhost:3002
APP_NAME=Vector-Brain
PORT=3002
NODE_ENV=development

# Database
MYSQLHOST=127.0.0.1
MYSQLPORT=3307
MYSQLUSERNAME=root
MYSQLPASSWORD=password
DATABASE=vector_brain
DBSYNC=true
MYSQL_EXTERNAL_PORT=3307
PHPMYADMIN_PORT=8080

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d
JWT_ALGORITHM=HS256

# AWS (optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_KEY=your_secret_key

# Email (optional)
# EMAIL_PROVIDER=smtp
# MAIL_FROM_NAME=Vector-Brain
# MAIL_FROM_ADDRESS=noreply@example.com
# SMTP_AUTH_HOST=smtp.example.com
# SMTP_MAIL_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_USER=your_smtp_user
# SMTP_AUTH_PASS=your_smtp_password

# Embedding Provider Configuration
EMBEDDING_PROVIDER=deepseek
EMBEDDING_API_KEY=your-deepseek-api-key-here
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_DIMENSIONS=1536

# Android multimodal planner (required for Android Agent; never inferred from embedding credentials)
ANDROID_AGENT_API_KEY=
# ANDROID_AGENT_MODEL=gpt-4o-mini

# Qdrant Vector Database Configuration
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=  # Optional, for production auth
QDRANT_COLLECTION_NAME=ai_rules
